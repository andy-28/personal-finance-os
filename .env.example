# PostgreSQL
POSTGRES_USER=pfos
POSTGRES_PASSWORD=pfos_dev_password
POSTGRES_DB=personal_finance
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# JWT
JWT_ISSUER=PersonalFinance.Api
JWT_AUDIENCE=PersonalFinance.Web
JWT_SIGNING_KEY=replace_with_a_long_development_signing_key_at_least_32_characters
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Production notes:
# - Replace every development secret before deploying.
# - Store production secrets in the hosting provider secret manager.
# - Restrict CORS to the deployed frontend origin.
# - Use HTTPS for all browser and API traffic.
