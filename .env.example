# Local Docker Compose PostgreSQL
POSTGRES_USER=pfos
POSTGRES_PASSWORD=pfos_dev_password
POSTGRES_DB=personal_finance
POSTGRES_PORT=5432

# Local Docker Compose Redis
REDIS_PORT=6379

# ASP.NET Core / Backend
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=55432;Database=personal_finance;Username=pfos;Password=pfos_dev_password
ConnectionStrings__Postgres=Host=localhost;Port=55432;Database=personal_finance;Username=pfos;Password=pfos_dev_password
ConnectionStrings__Redis=localhost:56379
Jwt__Key=replace_with_a_long_environment_specific_signing_key_at_least_32_characters
Jwt__SigningKey=replace_with_a_long_environment_specific_signing_key_at_least_32_characters
Jwt__Issuer=PersonalFinance.Api
Jwt__Audience=PersonalFinance.Web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30
Cors__AllowedOrigins__0=http://localhost:3100

# Frontend
# Browser requests use same-origin /api/* BFF routes. Do not expose the backend URL through NEXT_PUBLIC_*.
BACKEND_API_URL=http://localhost:5000

# Production notes:
# - Replace every development secret before deploying.
# - Store production secrets in the hosting provider secret manager.
# - Restrict CORS to the deployed frontend origin.
# - Use HTTPS for all browser and API traffic.
# - Do not commit real Neon, Upstash, Render, Vercel, JWT, or password values.
